<?xml version="1.0" encoding="UTF-8"?>
<comic_script version="1.0">
  <meta title="Two Scene Test" author="Test" />

  <assets>
    <character id="alice" name="Alice" src="alice.png" layer="platform" z="100" />
    <character id="bob" name="Bob" src="bob.png" layer="platform" z="110" />
    <facility id="park" src="park_bg.jpg" layer="background" z="0" />
    <facility id="night" src="night_bg.jpg" layer="background" z="0" />
  </assets>

  <scene id="1" duration="3.0">
    <initial_camera center_x="960" center_y="540" scale="1.0" />
    <initial_facilities>
      <place facility="park" x="960" y="540" />
    </initial_facilities>
    <initial_characters>
      <place character="alice" x="400" y="800" />
    </initial_characters>
    <timeline>
      <enter character="bob" method="slide_left" start="0.5" duration="0.8"
             target_x="1100" target_y="800" />
    </timeline>
  </scene>

  <transition type="fade" duration="1.0" />

  <scene id="2" duration="3.0">
    <initial_camera center_x="960" center_y="540" scale="1.0" />
    <initial_facilities>
      <place facility="night" x="960" y="540" />
    </initial_facilities>
    <initial_characters>
      <place character="alice" x="600" y="800" />
    </initial_characters>
    <timeline>
      <move character="alice" start="0.5" duration="1.5"
            to_x="900" to_y="800" easing="linear" />
    </timeline>
  </scene>
</comic_script>
